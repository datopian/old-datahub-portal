    "data": {
      "package": {
        "maintainer": "www.energiogklima.no",
        "name": "norske-utslipp",
        "author": "www.energiogklima.no",
        "url": "http://www.norskeutslipp.no/Templates/NorskeUtslipp/Pages/sektor.aspx?id=1106&epslanguage=no&SectorID=90",
        "notes": "Nettstedet norskeutslipp.no har oppdatert informasjon om utslipp, produksjonsmengder og avfall for de største forurensningskildene i Norge.\r\n\r\nData kan hentes ut i bl.a csv og Excel.\r\n\r\nDataene er både rapportert inn fra bedrifter med utslippstillatelse fra Klima- og forurensningsdirektoratet og fylkesmennene, og  beregnede data fra Statistisk sentralbyrå (SSB) og direktoratet.\r\n\r\nUtslipp som er registrert: Karbondioksid fossilt (CO2 (F)), Metan (CH4), Dioksiner i toksiske ekvivalenter (Dioksin), Nitrogenoksider (NOx), Svoveldioksid (SO2), Arsen (As), Kadmium (Cd), Krom (Cr), Kobber (Cu), Kvikksølv (Hg),   Bly (Pb), Lystgass (N2O), Partikler (PM10), Partikler (PM2,5), Partikler (TSP)\r\n\r\n",
        "owner_org": "c28c5caa-6941-45b2-8c90-6ec5e05b2d2c",
        "private": false,
        "maintainer_email": "",
        "author_email": "",
        "state": "active",
        "version": "1.0",
        "license_id": "notspecified",
        "title": "Norske utslipp",
        "revision_id": "c656c925-d304-45d6-b88a-8fe1de26ab7e",
