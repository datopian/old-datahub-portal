    "data": {
      "package": {
        "maintainer": "",
        "name": "kraftverk_konsesjonssaker",
        "author": "Olav A. Øvrebø",
        "url": "http://nve.no/no/Konsesjoner/Konsesjonssaker/",
        "notes": "Gir oversikt over konsesjonssaker for kraftverk som er til høyring, handsaming og tidlegare gjeve eller avslåtte søknader.\r\n\r\n    * Vannkraft\r\n    * Andre vassdragsinngrep\r\n    * Nett\r\n    * Vindkraft\r\n    * Fjernvarme  \r\n    * Gass- og kullkraft\r\n    * Andre energianlegg\r\n\r\nNVE handsamar meldingar og søknader om konsesjon etter vannressurslova, vassdragsreguleringslova, energilova og industrikonsesjonslova. Søknadene gjeld bygging av vasskraft og andre anlegg i vassdraga, større kraftleidningar, vindkraft, fjernvarme og andre energianlegg. Handsaminga omfattar mellom anna høyring av meldingane og søknadene, offentlege møter og møter med lokale og regionale myndigheiter. Gjennom prosessen skal NVE sikre at det er gjort greie for alle sider ved saka slik at det kan fattast eit vedtak der fordeler og ulemper er vekta opp mot kvarandre.\r\n",
        "owner_org": "c28c5caa-6941-45b2-8c90-6ec5e05b2d2c",
        "private": false,
