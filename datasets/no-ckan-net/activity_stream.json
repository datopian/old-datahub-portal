    "data": {
      "package": {
        "maintainer": "",
        "name": "statsregnskap-maanedlig",
        "author": "Olav A. Øvrebø",
        "url": "http://www.dfo.no/no/Forvaltning/Statsregnskapet/Manedlig-statsregnskap/",
        "notes": "Tall fra statsregnskapet publiseres månedlig av Direktoratet for økonomistyring.\r\n\r\nDet produseres tre rapporter: (1) Statens utgifter, (2) Statens inntekter og (3) Bevilgningshistorikk (endringer som er gjort på budsjettposter gjennom året).\r\n\r\nStatsregnskapet består av et bevilgnings- og et kapitalregnskap. Bevilgningsregnskapet er en oversikt over utgifter og inntekter i staten etter kontantprinsippet. Bevilgningsregnskapet presenteres månedlig. Kapitalregnskapet er en oppstilling av statens balanse og presenteres sammen med bevilgningsregnskapet i det årlige statsregnskapet (Meld. St. 3). Kapitalregnskapet har hovedvekt på statens finansielle eiendeler, gjeld og egenkapital. Statsregnskapet er basert på rapportering fra statlige virksomheter og departementene. \r\n\r\nSpørsmål kan rettes til: statsregnskap@dfo.no",
        "owner_org": "c28c5caa-6941-45b2-8c90-6ec5e05b2d2c",
        "private": false,
        "maintainer_email": "",
        "author_email": "",
        "state": "active",
        "version": "",
        "license_id": "notspecified",
        "title": "Statsregnskap - månedlig",
        "revision_id": "018911f4-e186-4ba1-b600-b8a9069eeda5",
        "type": "dataset",
        "id": "4f8314c5-8018-4f28-9491-df3c32bdf454"
