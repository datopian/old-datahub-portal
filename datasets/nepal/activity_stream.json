    "data": {
      "package": {
        "maintainer": "zocef",
        "name": "petroleum-products-prices",
        "author": "zocef",
        "url": null,
        "notes": "\r\nThis dataset was used in Open Data Day Hackathon to create an app. The dataset includes prices of petrol, disel and kerosene in Nepal and in India since 2004 to 2012. The price of LP gas in Nepal during that period is also included in this dataset.The prices of petroleum products in India which were in Indian Rupees have been converted to Nepalese rupees using the exchange rate. The dataset has been created with data from the following sources:\r\n\r\nPetroleum product prices in Nepal\r\nhttp://www.nepaloil.com.np/main/?opt1=sellingprice&opt2=previoussellingp...\r\n\r\nPetroleum product prices in India\r\nhttp://iocl.com/\r\n",
        "owner_org": "6bdddd0c-64cc-4b81-9074-28c5e98ea9ba",
        "private": false,
        "maintainer_email": "prantikpok@yahoocom",
