  {
    "user_id": "bb3a5d9d-0393-4b59-8b33-ae9e5769d24a",
    "timestamp": "2016-07-30T07:33:42.589873",
    "object_id": "d8551bcf-76d8-494a-adff-959e42d476fb",
    "revision_id": "a0b43e99-78bb-45d3-858c-d3aee1c10823",
    "data": {
      "package": {
        "maintainer": "",
        "name": "dbpedia-live",
        "metadata_modified": "2016-07-30T07:33:42.142084",
        "author": "OpenLink Software",
        "url": "http://live.dbpedia.org",
        "notes": "DBpedia.org is a community effort to extract structured \r\ninformation from Wikipedia and to make this information \r\navailable on the Web. DBpedia allows you to ask \r\nsophisticated queries against Wikipedia and to link other \r\ndatasets on the Web to Wikipedia data.\r\n\r\nThe DBpedia knowledge base currently describes more than 3.4 million things, out of which 1.5 million are classified in a consistent Ontology, including 312,000 persons, 413,000 places, 94,000 music albums, 49,000 films, 15,000 video games, 140,000 organizations, 146,000 species and 4,600 diseases. The DBpedia data set features labels and abstracts for these 3.2 million things in up to 92 different languages; 841,000 links to images and 5,081,000 links to external web pages; 9,393,000 external links into other RDF datasets, 565,000 Wikipedia categories, and 75,000 YAGO categories. The DBpedia knowledge base altogether consists of over 1 billion pieces of information (RDF triples) out of which 257 million were extracted from the English edition of Wikipedia and 766 million were extracted from other language editions.\r\n",
        "owner_org": "8aa2e195-e67f-414e-a901-23035eafa634",
        "private": false,
        "maintainer_email": "hwilliams@openlinksw.com",
        "author_email": "hwilliams@openlinksw.com",
        "state": "active",
        "version": "3.6",
        "creator_user_id": "17ce3af9-1580-4aa0-abcc-74494674b437",
        "id": "d8551bcf-76d8-494a-adff-959e42d476fb",
        "title": "DBpedia-Live",
        "revision_id": "a0b43e99-78bb-45d3-858c-d3aee1c10823",
        "type": "dataset",
        "license_id": "cc-by-sa"
      }
    },
