  {
    "user_id": "bb3a5d9d-0393-4b59-8b33-ae9e5769d24a",
    "timestamp": "2016-07-30T07:48:09.628016",
    "object_id": "59d456b7-b028-469d-be38-0d5eca56a88c",
    "revision_id": "bcfcaafa-450d-47e8-a21c-2eb783252606",
    "data": {
      "package": {
        "maintainer": "",
        "name": "dbpedia-pt",
        "metadata_modified": "2016-07-30T07:48:09.350809",
        "author": "Pablo Mendes",
        "url": "http://pt.dbpedia.org",
        "notes": "DBpedia Portuguese is being constructed by a working group to internationalize DBpedia to the [Lusosphere](http://en.wikipedia.org/wiki/Lusosphere \"what is lusosphere?\").\r\n\r\nWe are actively collaborating with the [DBpedia Internationalization Team](http://wiki.dbpedia.org/Internationalization) to include knowledge from the [Portuguese Language Wikipedia](http://pt.wikipedia.org) into DBpedia. As a first step, we have performed a preliminary extraction (available at http://pt.dbpedia.org) and are editing several mappings and labels to the DBpedia Ontology. The activity is organized via the mailing list dbpedia-portuguese@lists.sourceforge.net\r\n\r\nhttp://pt.dbpedia.org",
        "owner_org": "8aa2e195-e67f-414e-a901-23035eafa634",
        "private": false,
        "maintainer_email": "",
        "author_email": "pablo.mendes@fu-berlin.de",
        "state": "active",
        "version": "0.1",
        "creator_user_id": null,
        "id": "59d456b7-b028-469d-be38-0d5eca56a88c",
        "title": "DBpedia in Portuguese",
        "revision_id": "bbbda964-b505-499f-bd2a-492450edcf28",
        "type": "dataset",
        "license_id": "other-pd"
      }
    },
