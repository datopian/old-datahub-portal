  {
    "user_id": "81c5aded-46cd-452c-af73-050d434f1643",
    "timestamp": "2014-04-28T13:28:11.637311",
    "object_id": "3a135f47-95a2-4190-9c49-3d5ea8c707f6",
    "revision_id": "811572be-3092-4fa8-8458-b7e670f92b82",
    "data": {
      "group": {
        "description": "This organization is the repository for a large semi-synthetic, semantically rich dataset, modeled after the electronic medical record of a large medical institution. Using the highly diverse data.gov data repository and a multivariate data augmentation strategy, we can generate arbitrarily large semi-synthetic datasets which can be used to test new algorithms and computational platforms. The data is available both in relational (SQL) and semantic (RDF) forms.",
        "created": "2014-04-28T13:18:23.428125",
        "title": "Semi-Synthetic Benchmark",
        "name": "semi-synthetic-benchmark",
