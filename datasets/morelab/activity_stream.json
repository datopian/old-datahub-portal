    "data": {
      "package": {
        "maintainer": "",
        "name": "teseo",
        "author": "Aitor Almeida",
        "url": null,
        "notes": " Teseo is a Doctoral Dissertation database maintained by the Spanish Ministry of Education, keeping records for the dissertations defended in Spain since 1977. Teseo's website provides different forms to query the database, but makes it difficult for automatic processing.\r\n\r\nIn order to make it openly available to anyone, we scrapped all the information of the database and stored it in a relational database model. As most of the data is not validated (form fields accept any text string), there may be some errors related to the data, as we have automatically processed them in order to perform different analyses. Should you detect any error, you can find different ways to contact us on the about section.\r\n\r\nLinked Open Data: All the information is also publicly published as Linked Open Data, and queryable through the dedicated 4 million triples). ",
        "owner_org": "e47f4d99-889f-4db5-ac22-63d74a0fa08f",
