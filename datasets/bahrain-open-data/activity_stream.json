    "data": {
      "package": {
        "maintainer": "",
        "name": "bahrain-area-2006-2014",
        "author": "",
        "url": null,
        "notes": "    The Kingdom of Bahrain is located centrally on the southern shores of the Arabian Gulf, to the right of Saudi Arabia and North State of Qatar, between latitude 25° 32 & 26° 20 North and longitude 50° 20 and 50° 50 East. \r\n\r\nAnd the Kingdom of Bahrain is an archipelago of 40 islands, a total area of 767.26 square kilometers. The largest island is the island of Bahrain, which includes the capital (Manama), representing 80.68% of the total area of the islands of the Kingdom. And connect with the Kingdom of Saudi Arabia through the King Fahad Causeway, which opened in November 1986.\r\n",
        "owner_org": "cc5fa135-5b0d-4fac-85c2-83c57120e337",
